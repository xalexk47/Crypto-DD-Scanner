# Streamlit Cloud secrets — copy these into the app's Settings → Secrets box.
#
# This file is only a template. The real secrets.toml is gitignored and, on
# Streamlit Cloud, you never create a file at all: you paste the contents into
# the Secrets editor in the app's settings.
#
# Every name here matches the environment variables in .env.example, so the app
# reads them identically whether it runs on your laptop or on a host.

# --- Lock the app down (IMPORTANT when hosted) -----------------------------
# A hosted app is reachable by anyone who has the URL, and this dashboard shows
# real holdings. Set a password. Leave it out only when running locally.
APP_PASSWORD = "pick-something-long"

# --- Tell the app its disk is temporary ------------------------------------
# Hosts wipe the filesystem when an app sleeps or redeploys. With this set, the
# app warns you and offers Backup & restore prominently.
MEMEDD_EPHEMERAL_STORAGE = "1"

# --- Token discovery on BNB Chain and Base ---------------------------------
# Free key from https://etherscan.io/apis — one key covers every EVM chain.
ETHERSCAN_API_KEY = "your_key_here"

# --- Optional: a faster Solana endpoint ------------------------------------
# The public RPC throttles; a free Helius/QuickNode URL drops in unchanged.
# SOLANA_RPC_URL = "https://mainnet.helius-rpc.com/?api-key=..."

# --- Optional: the LLM layers ----------------------------------------------
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
# XAI_API_KEY = "xai-..."
