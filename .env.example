# ---------------------------------------------------------------------------
# MemeDD Dashboard configuration
#
# Copy to .env and fill in what you need:
#     cp .env.example .env
#
# EVERYTHING HERE IS OPTIONAL. With no .env at all the app runs fully on the
# free DexScreener and GoPlus public endpoints.
# ---------------------------------------------------------------------------

# --- LLM narrative layer (optional) ----------------------------------------
# Provider for the "Lore & Narrative" section. One of:
#   none | heuristic   -> built-in rules, no API key, no network (default)
#   anthropic | claude -> requires ANTHROPIC_API_KEY and `pip install anthropic`
#   openai | gpt       -> requires OPENAI_API_KEY and `pip install openai`
#   xai | grok         -> requires XAI_API_KEY and `pip install openai`
MEMEDD_LLM_PROVIDER=none

# Override the model id for the provider above (blank = provider default).
# e.g. claude-sonnet-4-5 / gpt-4o-mini / grok-4
MEMEDD_LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# --- Multi-LLM ensemble (optional) -----------------------------------------
# Sends the same token payload to Grok, Claude and GPT in parallel and combines
# their verdicts. Any provider without a key is skipped; one key is enough to
# start, three give you genuine cross-model agreement signal.
#
#   pip install anthropic openai
#
# Which providers to try, in order. Names: xai, anthropic, openai.
MEMEDD_ENSEMBLE_PROVIDERS=xai,anthropic,openai

# Per-provider model ids (each provider has its own, so you can mix tiers).
MEMEDD_ANTHROPIC_MODEL=claude-opus-5
MEMEDD_OPENAI_MODEL=gpt-4.1
MEMEDD_XAI_MODEL=grok-4.6

# How much the LLM consensus moves the final blended score (0.0-1.0).
# 0 = rules engine only, 1 = models only. The security veto always wins.
MEMEDD_ENSEMBLE_BLEND_WEIGHT=0.35

# MEMEDD_LLM_TIMEOUT=75        # seconds per model call
# MEMEDD_LLM_MAX_TOKENS=16000
# MEMEDD_LLM_TEMPERATURE=0.2   # OpenAI/xAI only; Claude rejects sampling params
# XAI_BASE_URL=https://api.x.ai/v1
# OPENAI_BASE_URL=            # set only for an OpenAI-compatible proxy

# --- X / Twitter mindshare via Grok (optional) -----------------------------
# Grok is the only major model with first-party X access, which is where
# meme-coin mindshare forms before it shows up in volume. Needs XAI_API_KEY.
#
# Verify what your key supports:  python scripts/check_grok.py
#
MEMEDD_X_SEARCH=1                       # 0 disables the feature entirely
MEMEDD_X_SEARCH_MODEL=grok-4.6          # check your console for available ids
MEMEDD_X_SEARCH_TOOL=x_search           # Agent Tools API tool, on /v1/responses
MEMEDD_X_SEARCH_MAX_RESULTS=20          # max 50
MEMEDD_X_SEARCH_WINDOW_HOURS=48         # how far back to search
MEMEDD_X_SEARCH_MAX_POSTS=6             # sample posts kept as evidence
MEMEDD_CACHE_TTL_MINDSHARE=900          # searches are billed — cache hard
MEMEDD_MINDSHARE_WEIGHT=0.3             # share of the momentum pillar it drives

# NOTE: established against the live API. chat.completions rejects x_search,
# and its own live_search alternative now returns 410 ("Live search is
# deprecated. Please switch to the Agent Tools API"). So X search runs through
# client.responses.create() on /v1/responses. The app tries several documented
# payload shapes and keeps the first the API accepts.

# --- On-chain wallet flow / smart money (optional) -------------------------
# A FREE Etherscan key covers every EVM chain (Base, Ethereum, Arbitrum, BSC)
# from one key via the chainid parameter: 5 calls/sec, 100k/day.
# Get one at https://etherscan.io/apis — no payment details needed.
ETHERSCAN_API_KEY=

# MEMEDD_WALLET_FLOW_MAX_TRANSFERS=3000   # transfers pulled per token (max 10000)
# MEMEDD_WALLET_FLOW_EARLY_HOURS=6        # window defining the "early buyer" cohort
# MEMEDD_WALLET_FLOW_RECENT_HOURS=24      # window for the accumulation read
# MEMEDD_WALLET_FLOW_CONSOLIDATION_PCT=12 # |24h move| under this counts as consolidation
# MEMEDD_SMART_MONEY_PATH=./data/smart_money.json

# Your own smart-money list — wallets and X handles you trust. Copy
# data/smart_money.example.json to data/smart_money.json and edit. This is the
# highest-precision signal in the app and it is gitignored, so it stays yours.

# --- GoPlus Security (optional) --------------------------------------------
# The token-security endpoint works unauthenticated. An app key only raises
# your rate limit: https://gopluslabs.io/
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# --- Networking / caching (optional tuning) --------------------------------
# MEMEDD_HTTP_TIMEOUT=12          # seconds per request
# MEMEDD_HTTP_RETRIES=2           # retries on 429 / 5xx / network errors
# MEMEDD_CACHE_TTL_TOKEN=120      # seconds to cache token market data
# MEMEDD_CACHE_TTL_SCANNER=180    # seconds to cache scanner sweeps
# MEMEDD_CACHE_TTL_SECURITY=600   # seconds to cache security reports
# MEMEDD_USER_AGENT=MemeDD-Dashboard/1.0

# --- Storage (optional) -----------------------------------------------------
# Where the local analysis history SQLite file lives.
# MEMEDD_DATA_DIR=./data

# --- API base URLs (optional; override only for mirrors/proxies) -----------
# DEXSCREENER_BASE_URL=https://api.dexscreener.com
# GOPLUS_BASE_URL=https://api.gopluslabs.io

# ===========================================================================
# Portfolio & rotation (all optional — sensible public defaults are built in)
# ===========================================================================
# Balances are read from public RPC nodes and public explorers. Nothing here
# is a key with spend authority, and the app never asks for a private key or
# seed phrase. Addresses in, prices out.

# --- EVM RPC endpoints ------------------------------------------------------
# Free public defaults are built in for Base, Ethereum, BNB Chain and
# Arbitrum. Override if you have a paid endpoint, or if a public one starts
# throttling you.
# BASE_RPC_URL=https://mainnet.base.org
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# ETHEREUM_RPC_URL=https://eth.llamarpc.com
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Robinhood Chain (Arbitrum Orbit, id 4663) ships with NO default RPC on
# purpose: shipping an unverified endpoint would be worse than saying so. Set
# yours here if you have one. Even without it, balances there are read through
# the Blockscout instance below.
# ROBINHOOD_RPC_URL=

# --- Solana -----------------------------------------------------------------
# The public RPC works but throttles hard. A Helius/QuickNode URL goes here
# unchanged and behaves the same, just faster and without the rate limiting.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Blockscout (token discovery without an API key) ------------------------
# One unauthenticated call returns every token balance for an address. This is
# the only discovery route on chains Etherscan V2 does not index.
# BASE_BLOCKSCOUT_URL=https://base.blockscout.com
# ROBINHOOD_BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com

# --- Portfolio behaviour ----------------------------------------------------
# MEMEDD_PORTFOLIO_DUST_USD=5             # positions under this roll into "dust"
# MEMEDD_PORTFOLIO_MAX_TOKENS=150         # cap on tokens read per wallet
# MEMEDD_PORTFOLIO_DISCOVERY_TRANSFERS=2000  # transfers scanned to find tokens
# MEMEDD_CACHE_TTL_PORTFOLIO=120

# --- Rotation ---------------------------------------------------------------
# MEMEDD_ROTATION_CHAINS=base,solana,bsc,robinhood
# MEMEDD_HEAT_PORTFOLIO_WEIGHT=0.4    # your bags vs the chain basket, 0-1
# MEMEDD_HEAT_HOT=68                  # heat at or above this reads as hot
# MEMEDD_HEAT_COLD=38                 # heat at or below this reads as cold
# MEMEDD_HEAT_TREND_EPSILON=4         # points of change that count as a trend
# MEMEDD_HEAT_LOOKBACK_HOURS=72       # trailing window for the state read
# MEMEDD_HEAT_DIVERGENCE=20           # your-bags vs chain gap worth flagging
# MEMEDD_BENCHMARK_BASKET_SIZE=25     # tokens sampled per chain
# MEMEDD_BENCHMARK_MIN_LIQUIDITY=25000
# MEMEDD_CACHE_TTL_CHAIN_STATS=600
# DEFILLAMA_BASE_URL=https://api.llama.fi
